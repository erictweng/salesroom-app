# Base URL of the local mock CRM API server (the binary from
# github.com/secureframe/salesroom-crm-servers). Defaults to :8080.
CRM_BASE_URL=http://localhost:8080

# Secret used to sign the app's own session cookie (NOT the CRM JWT).
# Any long random string works for local development.
SESSION_SECRET=dev-only-change-me-to-a-long-random-string

# Path to the local SQLite database file (rooms, room_resources, events).
# Relative paths resolve from the project root.
DATABASE_PATH=./data/salesroom.db

# Optional: pad the seller account picker with N synthetic accounts to stress-test
# search/filter/grid-list at scale. Leave unset (or 0) for the real 3 CRM accounts.
# Demo accounts are display-only — their "Create room" is disabled.
# DEMO_ACCOUNTS=100
